+} from '../lib/calc'
+import { plural } from '../lib/plural'
+
+type Tab = 'wound' | 'severance' | 'age' | 'bmi'
+
+const TABS: { id: Tab; label: string }[] = [
+  { id: 'wound', label: 'Ранение' },
