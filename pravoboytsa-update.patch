+              { value: 'heavy', label: 'Тяжёлое' },
+              { value: 'light', label: 'Лёгкое' },
+              { value: 'other', label: 'Иное' },
+            ]}
+          />
+        </Field>
+        <Field label="Установлена инвалидность">
+          <Segmented
+            value={disability}
